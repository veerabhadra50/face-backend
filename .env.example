# Supabase / PostgreSQL connection (REQUIRED — this is how the backend talks to the DB)
# Get this from Supabase: Project Settings -> Database -> Connection string (URI)
# Use the "Session pooler" or "Direct connection" URI. Replace [YOUR-PASSWORD].
# Example: postgresql://postgres.abcxyz:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/faceattendance

# Supabase project credentials (OPTIONAL)
# Get these from Supabase: Project Settings -> API.
#   SUPABASE_URL              -> "Project URL"
#   SUPABASE_ANON_KEY         -> "anon public" key (safe to expose to the frontend)
#   SUPABASE_SERVICE_ROLE_KEY -> "service_role" key (SECRET — server only, never expose)
# These are only needed if you query Supabase via its REST/JS client. The backend
# itself uses DATABASE_URL above and does not require these to work.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Face recognition tuning
# Cosine similarity threshold for a positive match (0.0 - 1.0). Higher = stricter.
FACE_MATCH_THRESHOLD=0.45

# Minimum detection confidence to accept a detected face
FACE_DET_THRESHOLD=0.5

# InsightFace model pack: buffalo_l (accurate, larger) or buffalo_s (smaller/faster)
INSIGHTFACE_MODEL=buffalo_l

# CORS: comma-separated list of allowed origins ("*" allows all)
CORS_ORIGINS=*

# Absolute path to the frontend folder to serve as static files (optional).
# If set, the UI is served at http://localhost:8000/
FRONTEND_DIR=D:\face-login\frontend
